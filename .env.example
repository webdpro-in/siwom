# Web3Forms uses the supplied public access key in lib/web3forms.ts.
# Confirm its recipient and production restrictions in your Web3Forms account.

# Optional Cloudflare Turnstile. When both are set, the widget renders on the
# contact form and the server verifies the token. The CSP allows Cloudflare only then.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public site URL, used for canonical URLs, Open Graph, sitemap and robots.
# An https:// URL also enables HSTS and upgrade-insecure-requests.
NEXT_PUBLIC_SITE_URL=

# --- Optional extras (not required) -------------------------------------------
# Cookieless Plausible analytics. Leave empty to disable all analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
